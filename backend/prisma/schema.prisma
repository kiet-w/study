// schema.prisma
// Prisma Schema for StudySnap: Category, Topic, Photo
// Map trực tiếp với Supabase PostgreSQL (categories, topics, photos)
// ⚠️ Lưu ý: KHÔNG khai báo model User trong Prisma để tránh tạo bảng public.users 
// gây sai lệch với Supabase Auth (auth.users) và hỏng RLS policies (auth.uid() = user_id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  color     String?
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  topics Topic[]
  photos Photo[]

  @@index([userId])
  @@map("categories")
}

model Topic {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  name       String
  color      String?
  icon       String?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  photos   Photo[]

  @@index([userId])
  @@index([categoryId])
  @@map("topics")
}

model Photo {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  topicId       String?   @map("topic_id") @db.Uuid
  storagePath   String    @map("storage_path")
  thumbnailPath String?   @map("thumbnail_path")
  note          String?
  takenAt       DateTime  @map("taken_at") @db.Timestamptz
  sortOrder     Int       @default(0) @map("sort_order")
  synced        Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  topic    Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, topicId])
  @@index([userId, categoryId])
  @@index([userId])
  @@index([synced])
  @@index([takenAt])
  @@map("photos")
}
